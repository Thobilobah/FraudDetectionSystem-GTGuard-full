# ================================================================
# UPI FraudGuard AI - Backend Configurations
# ================================================================

# Server Configurations
PORT=8000
HOST=0.0.0.0

# Database Connection (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://fraudguard:fraudguard@localhost:5432/fraudguard_db

# Model configuration paths
MODEL_PATH=backend/models/upi_fraud_pipeline.pkl
METADATA_PATH=backend/models/model_metadata.json
REPORTS_DIR=backend/reports

# Live payment integration: Razorpay credentials (OPTIONAL)
# If empty, the system operates securely in Demo/Simulation Mode.
RAZORPAY_KEY_ID=rzp_test_TQW4k625rvjsDW
RAZORPAY_KEY_SECRET=wMvFvP72glYrpQ2Wpx4dZZZy
RAZORPAY_WEBHOOK_SECRET=my_local_webhook_secret_key

# Risk Score Threshold limits:
# 0 - 39: LOW risk
# 40 - 69: MEDIUM risk
# 70 - 100: HIGH risk
RISK_THRESHOLD_LOW=40
RISK_THRESHOLD_HIGH=70

# Auth (JWT signing key for the login screen). Change this in production.
AUTH_SECRET_KEY=fraudguard-demo-secret-change-in-production
